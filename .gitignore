##############################################
# IGNORE LARGE FILES & DATA EXPORTS
##############################################

# Excel, CSV, dataset files (anywhere)
*.xlsx
*.xls
*.csv

# Knowledge Graph / RDF exports (anywhere)
*.ttl
*.nt
*.nq
*.owl
*.rdf
*.html
*.gz
*.rar
*.zip

# Generated KG-related names
kg_full/
mse_kg_full.ttl
mse_kg_full.nt
full_dataset_*
semiconductors_small*
*_featurized*
*_featureized*

##############################################
# PYTHON / NOTEBOOK / ENV IGNORE
##############################################

# Virtual environments
venv/
.env/
.env.bak/

# Python cache
__pycache__/
*.pyc

# Jupyter
.ipynb_checkpoints/

##############################################
# EDITOR / OS / MISC
##############################################

# VS Code
.vscode/

# Environment files
.env
*.env

# OS cruft
Thumbs.db
Desktop.ini
.DS_Store

# Local export dir (artifacts, figures, etc.)
export/

##############################################
# MODEL ARTIFACTS & FINETUNE OUTPUTS
##############################################

# Entire finetune folder — GGUFs, adapters, imatrix, logs, eval outputs.
# All regenerable from train_query_lora.py / train_parse_lora.py + the base model.
data/finetune/
!data/finetune/query_dataset.jsonl
!data/finetune/parse_dataset.jsonl

# Model file types, wherever they appear
*.gguf
*.safetensors
*.bin
*.pth

# Training side-effect dirs some frameworks create
wandb/
runs/
checkpoints/
unsloth_compiled_cache/

##############################################
# PYTHON ENV (correct venv name)
##############################################
.venv/

